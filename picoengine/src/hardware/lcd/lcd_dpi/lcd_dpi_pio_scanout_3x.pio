.define PCLK_SCND 1     ; 1 = inverted polarity PCLK state on 1st half of the cycle (1 = data on falling edge, 0 = data on rising edge)
.define PCLK_FRST 0     ; 0 = inverted polarty, PCLK state on 2nd half of the cycle (0 = data on falling edge, 1 = data on rising edge)
.define DE_IDLE 0       ; 1 = inverted polarity
.define DE_ACTIVE 1     ; 0 = inverted polarity

.define visible_pixels 0
.define hsync_pixels   1
.define vsync_pixels   2

.program lcd_scanout_3x

.side_set 1 opt

.fifo txget

.wrap_target
 next_line:
    mov osr, rxfifo[visible_pixels]   side PCLK_FRST             ; load no of visible pixels
	out x, 16                         side PCLK_SCND

	scanout:
	out pins, 16                      side PCLK_FRST
    set pins, DE_ACTIVE               side PCLK_SCND            ; relocated to inside the loop to save 1 instruction (replaces one NOP)
    nop                               side PCLK_FRST
    nop                               side PCLK_SCND
    nop                               side PCLK_FRST
    jmp x-- scanout                   side PCLK_SCND

    set pins, DE_IDLE                 side PCLK_FRST

    ; if scaling==3 then 1024/scaling does not result in an integer,
    ; so any 3rd row there will be a rounding error of "1" which 
    ; has to be accounted for
    mov x, isr                        side PCLK_SCND
    jmp x-- regularline               side PCLK_FRST
    set x, 2                          side PCLK_SCND
    out null, 16                      side PCLK_FRST
    
    regularline:
    mov isr, x                        side PCLK_SCND

    ;hsync
    mov osr, rxfifo[hsync_pixels]     side PCLK_FRST             ; load no of hsync pixels
	mov x, osr                        side PCLK_SCND

    hblanking:
    out null, 8                       side PCLK_FRST
    jmp x-- hblanking                 side PCLK_SCND

    jmp next_line                     side PCLK_SCND

public vsync:

    ;vsync
	mov osr, rxfifo[vsync_pixels]     side PCLK_FRST              ; load no of visible lines to line counter
	mov x, osr                        side PCLK_SCND

    vblanking:
    nop                               side PCLK_SCND
    jmp x-- vblanking                 side PCLK_FRST
.wrap


% c-sdk {

%}
