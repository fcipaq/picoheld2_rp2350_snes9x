; calculate address of LUT entry

.program lcd_calc_clut_addr

    .wrap_target
public calc_lut_entry:
    mov isr, x            ; base address to ISR (lst 9 bits missing)
    pull block
    in osr, 8             ; lo byte from OSR (8 bits)
    in null, 1            ; map 8 bit --> 9 bit address
    .wrap

% c-sdk {

%}