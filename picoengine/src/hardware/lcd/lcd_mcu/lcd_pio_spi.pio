; SPI mode 0 data transmission to LCD

.program lcd_output

.side_set 1 opt

    .wrap_target
label_tx:
    out pins, 1           side 0   ; Stall here on empty (keep SCK deasserted)
    jmp label_tx          side 1   ; repeat, WR set to HIGH
public tx_uint8:
    out null, 8                    ; discard hi byte
    .wrap

% c-sdk {

%}
