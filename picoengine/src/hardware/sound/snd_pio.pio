.program snd_output

.side_set 2

public entry_point:

.wrap_target
; ------------------------------------------
    set y, 13         side 0b00
    nop               side 0b10
chan_l:
    nop               side 0b00
    jmp y-- chan_l    side 0b10

; ------------------------------------------
    set y, 14         side 0b01
    pull noblock      side 0b11  ; 1 pull (32 bits is enough for 2 cycles since it's mono audio only)
chan_r:
    out pins, 1       side 0b01
    jmp y-- chan_r    side 0b11

    out pins, 1       side 0b00
    nop               side 0b10

; ------------------------------------------
    set y, 13         side 0b00
    nop               side 0b10
chan_l2:
    nop               side 0b00
    jmp y-- chan_l2   side 0b10

; ------------------------------------------
    set y, 14         side 0b01
    nop               side 0b11
chan_r2:
    out pins, 1       side 0b01
    jmp y-- chan_r2   side 0b11

    out pins, 1       side 0b00
    nop               side 0b10

.wrap

% c-sdk {

%}
